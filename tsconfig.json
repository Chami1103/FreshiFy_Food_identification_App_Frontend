{
  "extends": "./node_modules/expo/tsconfig.base",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",

    "strict": true,
    "skipLibCheck": true,
    "allowJs": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,

    "types": ["@types/react", "@types/react-dom", "@types/node"],

    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@/config/*": ["config/*"],
      "@/screens/*": ["screens/*"],
      "@/services/*": ["services/*"],
      "@/components/*": ["components/*"],
      "@/contexts/*": ["contexts/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "index.tsx",
    "app/**/*",
    "screens/**/*",
    "components/**/*",
    "services/**/*",
    "contexts/**/*",
    "hooks/**/*",
    "utils/**/*",
    "config/**/*",
    "types/**/*"
  ],
  "exclude": ["node_modules"]
}
