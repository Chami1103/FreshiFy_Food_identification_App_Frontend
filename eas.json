{
  "cli": {
    "version": ">= 14.0.0"
  },
  "build": {
    /* 🧑‍💻 Local Testing Build (runs with Expo Go or Dev Client) */
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_BACKEND_HOST": "192.168.8.102",
        "EXPO_PUBLIC_SENSOR_PORT": "5000",
        "EXPO_PUBLIC_IMAGE_PORT": "5001",
        "EXPO_PUBLIC_NOTIFY_PORT": "5002"
      }
    },

    /* 🚀 Internal QA or Demo Build (optional stage before production) */
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_BACKEND_HOST": "192.168.8.102",
        "EXPO_PUBLIC_SENSOR_PORT": "5000",
        "EXPO_PUBLIC_IMAGE_PORT": "5001",
        "EXPO_PUBLIC_NOTIFY_PORT": "5002"
      }
    },

    /* 🌍 Production Build (AWS EC2 deployment target) */
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_BACKEND_HOST": "ec2-54-201-120-210.ap-southeast-1.compute.amazonaws.com", 
        "EXPO_PUBLIC_SENSOR_PORT": "5000",
        "EXPO_PUBLIC_IMAGE_PORT": "5001",
        "EXPO_PUBLIC_NOTIFY_PORT": "5002"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
